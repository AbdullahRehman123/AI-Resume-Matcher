# Copy this file to .env and fill in real values. .env is gitignored.

HF_TOKEN=your_huggingface_token

DATABASE_URL=postgresql://user:password@localhost:5432/cv_matcher

REDIS_URL=redis://localhost:6379/0

# JWT signing key. Generate a real random value for actual use, never
# the example placeholder below - anyone with this key can forge valid
# login tokens for any user:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-real-random-value

# LOG_LEVEL=DEBUG
# EXTRACTOR_MODEL=meta-llama/Llama-3.1-8B-Instruct
# MATCHER_MODEL=meta-llama/Llama-3.1-8B-Instruct
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Daily CV-processing caps and signup rate limit (Redis-backed, see
# app/usage_limits.py). Defaults shown - uncomment to override.
# GLOBAL_DAILY_CV_CAP=30
# USER_DAILY_CV_CAP=10
# SIGNUP_RATE_LIMIT_PER_HOUR=3

# Resend (transactional email for account verification, app/email_service.py).
# If RESEND_API_KEY is unset, /auth/signup falls back to returning the
# verification link directly in the response instead of emailing it -
# Resend is optional for local dev.
# RESEND_API_KEY=re_your_api_key
#
# FROM_EMAIL must be a Resend-verified sender/domain or sends will fail.
# onboarding@resend.dev works without verifying your own domain, but Resend
# only lets it deliver to the email address on your own Resend account
# until you verify a custom domain - fine for solo testing, not for real users.
# FROM_EMAIL=onboarding@resend.dev

# Which backend runs CV extraction (app/tasks.py). Two valid values:
#   celery  - default. Needs Redis + a running Celery worker; retries on
#             transient failures (max_retries=3).
#   fastapi - runs in-process via FastAPI's BackgroundTasks. No worker to
#             deploy/pay for, but no automatic retry on failure, and it
#             shares the API server's resources. Fine for low-volume or
#             free-tier deployment at this app's batch size (max 5 CVs);
#             switch back to "celery" later by changing just this value.
TASK_BACKEND=celery
